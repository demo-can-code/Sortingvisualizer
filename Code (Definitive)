def bubble_sort(arr):

    n = len(arr)

    for i in range(n):

        for j in range(n - i - 1):

            play_note()

            if arr[j] > arr[j + 1]:
                arr[j], arr[j + 1] = arr[j + 1], arr[j]

            yield {j: RED, j + 1: YELLOW}

        x = (n - i - 1) * (WIDTH / len(arr))
        y = HEIGHT - arr[n - i - 1]

        create_particles(x, y, GREEN)

        yield {n - i - 1: GREEN}


def insertion_sort(arr):

    for i in range(1, len(arr)):

        key = arr[i]
        j = i - 1

        while j >= 0 and arr[j] > key:

            play_note()

            arr[j + 1] = arr[j]

            yield {j: RED, j + 1: YELLOW}

            j -= 1

        arr[j + 1] = key

        x = (j + 1) * (WIDTH / len(arr))
        y = HEIGHT - arr[j + 1]

        create_particles(x, y, CYAN)

        yield {j + 1: CYAN}


def selection_sort(arr):

    n = len(arr)

    for i in range(n):

        min_idx = i

        for j in range(i + 1, n):

            play_note()

            if arr[j] < arr[min_idx]:
                min_idx = j

            yield {min_idx: PURPLE, j: RED}

        arr[i], arr[min_idx] = arr[min_idx], arr[i]

        x = i * (WIDTH / len(arr))
        y = HEIGHT - arr[i]

        create_particles(x, y, PURPLE)

        yield {i: GREEN}


def merge_sort(arr):
    yield from merge_sort_recursive(arr, 0, len(arr) - 1)


def merge_sort_recursive(arr, left, right):

    if left >= right:
        return

    mid = (left + right) // 2

    yield from merge_sort_recursive(arr, left, mid)
    yield from merge_sort_recursive(arr, mid + 1, right)

    yield from merge(arr, left, mid, right)


def merge(arr, left, mid, right):

    left_part = arr[left : mid + 1]
    right_part = arr[mid + 1 : right + 1]

    i = 0
    j = 0
    k = left

    while i < len(left_part) and j < len(right_part):

        play_note()

        if left_part[i] < right_part[j]:
            arr[k] = left_part[i]
            i += 1

        else:
            arr[k] = right_part[j]
            j += 1

        x = k * (WIDTH / len(arr))
        y = HEIGHT - arr[k]

        create_particles(x, y, CYAN, 6)

        yield {k: CYAN}

        k += 1

    while i < len(left_part):

        arr[k] = left_part[i]

        yield {k: GREEN}

        i += 1
        k += 1

    while j < len(right_part):

        arr[k] = right_part[j]

        yield {k: GREEN}

        j += 1
        k += 1

