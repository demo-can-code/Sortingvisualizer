# ---------------- COMB SORT ---------------- #


def comb_sort(arr):

    gap = len(arr)
    shrink = 1.3
    sorted_flag = False

    while not sorted_flag:

        gap = int(gap / shrink)

        if gap <= 1:
            gap = 1
            sorted_flag = True

        i = 0

        while i + gap < len(arr):

            if arr[i] > arr[i + gap]:

                arr[i], arr[i + gap] = arr[i + gap], arr[i]

                sorted_flag = False

            yield {i: RED, i + gap: CYAN}

            i += 1


# ---------------- ODD EVEN SORT ---------------- #


def odd_even_sort(arr):

    sorted_flag = False

    while not sorted_flag:

        sorted_flag = True

        for i in range(1, len(arr) - 1, 2):

            if arr[i] > arr[i + 1]:

                arr[i], arr[i + 1] = arr[i + 1], arr[i]

                sorted_flag = False

            yield {i: PURPLE, i + 1: YELLOW}

        for i in range(0, len(arr) - 1, 2):

            if arr[i] > arr[i + 1]:

                arr[i], arr[i + 1] = arr[i + 1], arr[i]

                sorted_flag = False

            yield {i: CYAN, i + 1: RED}


# ---------------- PANCAKE SORT ---------------- #


def pancake_sort(arr):

    curr_size = len(arr)

    while curr_size > 1:

        max_idx = arr.index(max(arr[:curr_size]))

        if max_idx != curr_size - 1:

            arr[: max_idx + 1] = reversed(arr[: max_idx + 1])

            yield {max_idx: RED}

            arr[:curr_size] = reversed(arr[:curr_size])

            yield {curr_size - 1: GREEN}

        curr_size -= 1


# ---------------- STOOGE SORT 💀 ---------------- #


def stooge_sort(arr):
    yield from stooge_recursive(arr, 0, len(arr) - 1)


def stooge_recursive(arr, l, h):

    if l >= h:
        return

    if arr[l] > arr[h]:

        arr[l], arr[h] = arr[h], arr[l]

        yield {l: RED, h: YELLOW}

    if h - l + 1 > 2:

        t = (h - l + 1) // 3

        yield from stooge_recursive(arr, l, h - t)
        yield from stooge_recursive(arr, l + t, h)
        yield from stooge_recursive(arr, l, h - t)


# ---------------- CYCLE SORT ---------------- #


def cycle_sort(arr):

    n = len(arr)

    for cycle_start in range(n - 1):

        item = arr[cycle_start]

        pos = cycle_start

        for i in range(cycle_start + 1, n):

            if arr[i] < item:
                pos += 1

            yield {i: CYAN, cycle_start: PURPLE}

        if pos == cycle_start:
            continue

        while item == arr[pos]:
            pos += 1

        arr[pos], item = item, arr[pos]

        yield {pos: GREEN}

        while pos != cycle_start:

            pos = cycle_start

            for i in range(cycle_start + 1, n):

                if arr[i] < item:
                    pos += 1

            while item == arr[pos]:
                pos += 1

            arr[pos], item = item, arr[pos]

            yield {pos: YELLOW}


# ---------------- STRAND SORT ---------------- #


def strand_sort(arr):

    output = []

    while arr:

        strand = [arr.pop(0)]

        i = 0

        while i < len(arr):

            if arr[i] >= strand[-1]:

                strand.append(arr.pop(i))

            else:
                i += 1

        output = merge_strands(output, strand)

        for i in range(len(output)):

            yield {i: CYAN}

    arr.extend(output)


def merge_strands(a, b):

    result = []

    while a and b:

        if a[0] < b[0]:
            result.append(a.pop(0))
        else:
            result.append(b.pop(0))

    result.extend(a)
    result.extend(b)

    return result


# ---------------- BITONIC SORT ---------------- #


def bitonic_sort(arr):
    yield from bitonic_recursive(arr, 0, len(arr), 1)


def bitonic_recursive(arr, low, cnt, direction):

    if cnt > 1:

        k = cnt // 2

        yield from bitonic_recursive(arr, low, k, 1)
        yield from bitonic_recursive(arr, low + k, k, 0)

        yield from bitonic_merge(arr, low, cnt, direction)


def bitonic_merge(arr, low, cnt, direction):

    if cnt > 1:

        k = cnt // 2

        for i in range(low, low + k):

            if (direction == 1 and arr[i] > arr[i + k]) or (
                direction == 0 and arr[i] < arr[i + k]
            ):

                arr[i], arr[i + k] = arr[i + k], arr[i]

            yield {i: RED, i + k: CYAN}

        yield from bitonic_merge(arr, low, k, direction)
        yield from bitonic_merge(arr, low + k, k, direction)


