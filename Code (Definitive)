def quick_sort(arr):
    yield from quick_sort_recursive(arr, 0, len(arr) - 1)


def quick_sort_recursive(arr, low, high):

    if low < high:

        pivot_index = yield from partition(arr, low, high)

        yield from quick_sort_recursive(arr, low, pivot_index - 1)
        yield from quick_sort_recursive(arr, pivot_index + 1, high)


def partition(arr, low, high):

    pivot = arr[high]

    i = low - 1

    for j in range(low, high):

        if arr[j] < pivot:

            i += 1

            arr[i], arr[j] = arr[j], arr[i]

        create_particles(
            j * (WIDTH / len(arr)),
            HEIGHT - arr[j],
            PURPLE,
            2
        )

        yield {
            j: RED,
            high: PURPLE,
            i: CYAN
        }

    arr[i + 1], arr[high] = arr[high], arr[i + 1]

    yield {
        i + 1: GREEN
    }

    return i + 1


# ---------------- HEAP SORT ---------------- #


def heap_sort(arr):

    n = len(arr)

    for i in range(n // 2 - 1, -1, -1):
        yield from heapify(arr, n, i)

    for i in range(n - 1, 0, -1):

        arr[i], arr[0] = arr[0], arr[i]

        yield {i: GREEN, 0: RED}

        yield from heapify(arr, i, 0)


def heapify(arr, n, i):

    largest = i

    left = 2 * i + 1
    right = 2 * i + 2

    if left < n and arr[left] > arr[largest]:
        largest = left

    if right < n and arr[right] > arr[largest]:
        largest = right

    if largest != i:

        arr[i], arr[largest] = arr[largest], arr[i]

        yield {i: YELLOW, largest: PURPLE}

        yield from heapify(arr, n, largest)


# ---------------- SHELL SORT ---------------- #


def shell_sort(arr):

    n = len(arr)

    gap = n // 2

    while gap > 0:

        for i in range(gap, n):

            temp = arr[i]

            j = i

            while j >= gap and arr[j - gap] > temp:

                arr[j] = arr[j - gap]

                yield {j: RED, j - gap: CYAN}

                j -= gap

            arr[j] = temp

            yield {j: GREEN}

        gap //= 2


# ---------------- COCKTAIL SORT ---------------- #


def cocktail_sort(arr):

    n = len(arr)

    swapped = True

    start = 0
    end = n - 1

    while swapped:

        swapped = False

        for i in range(start, end):

            if arr[i] > arr[i + 1]:

                arr[i], arr[i + 1] = arr[i + 1], arr[i]

                swapped = True

            yield {i: RED, i + 1: YELLOW}

        if not swapped:
            break

        swapped = False

        end -= 1

        for i in range(end - 1, start - 1, -1):

            if arr[i] > arr[i + 1]:

                arr[i], arr[i + 1] = arr[i + 1], arr[i]

                swapped = True

            yield {i: PURPLE, i + 1: CYAN}

        start += 1


# ---------------- GNOME SORT ---------------- #


def gnome_sort(arr):

    index = 0

    n = len(arr)

    while index < n:

        if index == 0:
            index += 1

        if index >= n:
            break

        if arr[index] >= arr[index - 1]:
            index += 1

        else:

            arr[index], arr[index - 1] = arr[index - 1], arr[index]

            yield {index: RED, index - 1: YELLOW}

            index -= 1

