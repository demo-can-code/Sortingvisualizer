# =====================================================
# SOUND ENGINE
# =====================================================

sample_rate = 44100


def create_tone(freq=440, duration=0.03, volume=0.15):

    n_samples = int(sample_rate * duration)

    buf = bytearray()

    fade = int(n_samples * 0.1)

    for s in range(n_samples):

        t = s / sample_rate

        wave = (
            0.6 * math.sin(2 * math.pi * freq * t)
            + 0.25 * math.sin(2 * math.pi * freq * 2 * t)
            + 0.15 * math.sin(2 * math.pi * freq * 3 * t)
        )

        envelope = 1.0

        if s < fade:
            envelope = s / fade

        elif s > n_samples - fade:
            envelope = (n_samples - s) / fade

        value = int(wave * 32767 * volume * envelope)

        buf.extend(value.to_bytes(2, byteorder="little", signed=True))
        buf.extend(value.to_bytes(2, byteorder="little", signed=True))

    return pygame.mixer.Sound(buffer=bytes(buf))


notes = [
    261.63,
    293.66,
    329.63,
    392.00,
    440.00,
    523.25
]

note_index = 0

sounds = [create_tone(n, 0.025, 0.08) for n in notes]
complete_sound = create_tone(783.99, 0.15, 0.18)



def play_note():

    global note_index

    sounds[note_index].play()

    note_index += 1

    if note_index >= len(sounds):
        note_index = 0

# =====================================================
# ARRAY
# =====================================================


def generate_array():
    return [random.randint(MIN_VAL, MAX_VAL) for _ in range(ARRAY_SIZE)]


arr = generate_array()

# =====================================================
# PARTICLES
# =====================================================

particles = []



def create_particles(x, y, color, amount=12):

    for _ in range(amount):

        particles.append({
            "x": x,
            "y": y,
            "dx": random.uniform(-3, 3),
            "dy": random.uniform(-6, -1),
            "life": random.randint(25, 50),
            "color": color,
            "size": random.randint(2, 5)
        })



def update_particles():

    for p in particles[:]:

        p["x"] += p["dx"]
        p["y"] += p["dy"]

        p["dy"] += 0.15

        p["life"] -= 1

        alpha = max(0, p["life"] * 5)

        surf = pygame.Surface((20, 20), pygame.SRCALPHA)

        pygame.draw.circle(
            surf,
            (*p["color"], alpha),
            (10, 10),
            p["size"]
        )

        screen.blit(surf, (p["x"], p["y"]))

        if p["life"] <= 0:
            particles.remove(p)

# =====================================================
# STARS
# =====================================================

stars = []

for _ in range(120):

    stars.append({
        "x": random.randint(0, WIDTH),
        "y": random.randint(0, HEIGHT),
        "speed": random.uniform(0.2, 1.2),
        "size": random.randint(1, 3)
    })



def draw_stars():

    for star in stars:

        star["y"] += star["speed"]

        if star["y"] > HEIGHT:
            star["y"] = 0
            star["x"] = random.randint(0, WIDTH)

        pygame.draw.circle(
            screen,
            (255, 255, 255),
            (int(star["x"]), int(star["y"])),
            star["size"]
        )

# =====================================================
# BACKGROUND
# =====================================================


def draw_gradient():

    for y in range(HEIGHT):

        ratio = y / HEIGHT

        r = int(BG_TOP[0] * (1 - ratio) + BG_BOTTOM[0] * ratio)
        g = int(BG_TOP[1] * (1 - ratio) + BG_BOTTOM[1] * ratio)
        b = int(BG_TOP[2] * (1 - ratio) + BG_BOTTOM[2] * ratio)

        pygame.draw.line(screen, (r, g, b), (0, y), (WIDTH, y))

