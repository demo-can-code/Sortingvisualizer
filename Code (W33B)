# =====================================================
# DRAW ARRAY
# =====================================================



def draw_array(arr, highlights={}):

    bar_width = WIDTH / len(arr)

    for i, value in enumerate(arr):

        x = i * bar_width
        y = HEIGHT - value - 35

        color = (225, 230, 255)

        if i in highlights:
            color = highlights[i]

        glow = pygame.Surface((bar_width + 14, value + 14), pygame.SRCALPHA)

        pygame.draw.rect(
            glow,
            (*color, 45),
            (0, 0, bar_width + 14, value + 14),
            border_radius=14
        )

        screen.blit(glow, (x - 7, y - 7))

        pygame.draw.rect(
            screen,
            color,
            (x, y, bar_width - 2, value),
            border_radius=10
        )

# =====================================================
# SORTS
# =====================================================



def bubble_sort(arr):

    n = len(arr)

    for i in range(n):

        for j in range(n - i - 1):

            play_note()

            if arr[j] > arr[j + 1]:
                arr[j], arr[j + 1] = arr[j + 1], arr[j]

            yield {
                j: RED,
                j + 1: YELLOW
            }

        x = (n - i - 1) * (WIDTH / len(arr))
        y = HEIGHT - arr[n - i - 1]

        create_particles(x, y, GREEN)

        yield {
            n - i - 1: GREEN
        }



def insertion_sort(arr):

    for i in range(1, len(arr)):

        key = arr[i]
        j = i - 1

        while j >= 0 and arr[j] > key:

            play_note()

            arr[j + 1] = arr[j]

            yield {
                j: RED,
                j + 1: YELLOW
            }

            j -= 1

        arr[j + 1] = key

        x = (j + 1) * (WIDTH / len(arr))
        y = HEIGHT - arr[j + 1]

        create_particles(x, y, CYAN)

        yield {
            j + 1: CYAN
        }



def selection_sort(arr):

    n = len(arr)

    for i in range(n):

        min_idx = i

        for j in range(i + 1, n):

            play_note()

            if arr[j] < arr[min_idx]:
                min_idx = j

            yield {
                min_idx: PURPLE,
                j: RED
            }

        arr[i], arr[min_idx] = arr[min_idx], arr[i]

        x = i * (WIDTH / len(arr))
        y = HEIGHT - arr[i]

        create_particles(x, y, PURPLE)

        yield {
            i: GREEN
        }



def merge_sort(arr):
    yield from merge_sort_recursive(arr, 0, len(arr) - 1)



def merge_sort_recursive(arr, left, right):

    if left >= right:
        return

    mid = (left + right) // 2

    yield from merge_sort_recursive(arr, left, mid)
    yield from merge_sort_recursive(arr, mid + 1, right)

    yield from merge(arr, left, mid, right)



def merge(arr, left, mid, right):

    left_part = arr[left:mid + 1]
    right_part = arr[mid + 1:right + 1]

    i = 0
    j = 0
    k = left

    while i < len(left_part) and j < len(right_part):

        play_note()

        if left_part[i] < right_part[j]:
            arr[k] = left_part[i]
            i += 1

        else:
            arr[k] = right_part[j]
            j += 1

        x = k * (WIDTH / len(arr))
        y = HEIGHT - arr[k]

        create_particles(x, y, CYAN, 6)

        yield {
            k: CYAN
        }

        k += 1

    while i < len(left_part):

        arr[k] = left_part[i]

        yield {
            k: GREEN
        }

        i += 1
        k += 1

    while j < len(right_part):

        arr[k] = right_part[j]

        yield {
            k: GREEN
        }

        j += 1
        k += 1

# =====================================================
# FINAL EFFECT
# =====================================================



def final_flash():

    for alpha in range(0, 180, 6):

        overlay = pygame.Surface((WIDTH, HEIGHT), pygame.SRCALPHA)

        overlay.fill((255, 255, 255, alpha))

        screen.blit(overlay, (0, 0))

        text = TITLE_FONT.render(
            "SORT COMPLETE ✨",
            True,
            WHITE
        )

        screen.blit(text, (WIDTH // 2 - 200, HEIGHT // 2 - 40))

        pygame.display.update()

        clock.tick(60)

# =====================================================
# MAIN LOOP
# =====================================================

sorting = False
sorting_algorithm = None
sorting_name = "Idle"

running = True

while running:

    clock.tick(FPS)

    draw_gradient()

    draw_stars()

    draw_ui(sorting_name)

    if sorting and sorting_algorithm:

        try:

            highlights = next(sorting_algorithm)

            draw_array(arr, highlights)

        except StopIteration:

            sorting = False
            sorting_name = "Completed ✨"

            complete_sound.play()

            for _ in range(100):

                create_particles(
                    random.randint(0, WIDTH),
                    random.randint(0, HEIGHT),
                    random.choice([CYAN, PURPLE, GREEN, PINK]),
                    amount=18
                )

            final_flash()

    else:

        draw_array(arr)

    update_particles()

    pygame.display.update()

    for event in pygame.event.get():

        if event.type == pygame.QUIT:
            running = False

        if event.type == pygame.KEYDOWN:

            if event.key == pygame.K_r and not sorting:

                arr = generate_array()
                sorting_name = "Idle"
                quote = random.choice(anime_quotes)

            elif event.key == pygame.K_b and not sorting:

                sorting = True
                sorting_name = "Bubble Breathing"
                sorting_algorithm = bubble_sort(arr)

            elif event.key == pygame.K_i and not sorting:

                sorting = True
                sorting_name = "Insertion Instinct"
                sorting_algorithm = insertion_sort(arr)

            elif event.key == pygame.K_s and not sorting:

                sorting = True
                sorting_name = "Selection Requiem"
                sorting_algorithm = selection_sort(arr)

            elif event.key == pygame.K_m and not sorting:

                sorting = True
                sorting_name = "Merge Ascension"
                sorting_algorithm = merge_sort(arr)

pygame.quit()
sys.exit()



